# Backend API base URL
VITE_API_BASE_URL=http://localhost:8005/api

# Company ID — get this from Admin Panel > Settings > Aura Shop Integration
VITE_COMPANY_ID=

# Real-time (Reverb WebSocket)
VITE_REVERB_ENABLED=true
VITE_REVERB_APP_KEY=local-app-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8088
VITE_REVERB_SCHEME=http
